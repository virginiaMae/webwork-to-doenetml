Doenet-Sync-ID: eMnRjTRi15wivCofjiQm1i
Doenet-Sync-Version: 0.7.28
Doenet-Sync-NumVariants: 4
Doenet-Sync-Hash: e8a454afd462fa0e
-->
<problem boxed>
  <setup>
    <selectFromSequence name="a" from="2" to="5" />
    <math name="b" simplify>$a + 1</math>
    <math name="c" simplify>2 * $a</math>
    <math name="d" simplify>$a * $b</math>
    <math name="f" simplify="numbersPreserveOrder">(2 * $a - 1) * n</math>

    <math name="lhs" simplify="numbersPreserveOrder">n / (n + $a) + 1 / (n - $b)</math>
    <math name="rhs" simplify="numbersPreserveOrder">($c - $f) / (n^2 - n - $d)</math>
    
    <math name="ans">1</math>
  </setup>

  <p>Solve the equation</p>
  <p><m>\displaystyle $lhs = $rhs</m></p>

  <p>
    <answer name="ans1">
      <label>Solutions (separate by commas): <m>n =</m></label>
      <award>$ans</award>
      <award credit="0" name="both" unorderedCompare>1, -$a</award>
    </answer>
  </p>

  <feedback condition="$both">Check both of your solutions by plugging them into the equation.</feedback>

  <givenAnswer>
    <p><m>n = $ans</m></p>
  </givenAnswer>
</problem>


<!-- ## DESCRIPTION
##  Algebra: Fractional equations 
## ENDDESCRIPTION


## DBsubject(Algebra)
## DBchapter(Rational equations and functions)
## DBsection(Rational equations)
## Date(10/26/2009)
## Institution(University of Minnesota)
## Author(Jonathan Rogness)
## Level(3)
## MO(1)
## TitleText1('Algebra for College Students')
## AuthorText1('Kaufmann, Schwitters')
## EditionText1('8')
## Section1('4.7')
## Problem1('12')
## KEYWORDS('algebra', 'fractional equations')

########################################################################

DOCUMENT();      

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "answerHints.pl",
  "PGcourse.pl"
);

########################################################################

TEXT(beginproblem());

$showPartialCorrectAnswers = 1;

########################################################################

Context("Numeric");
Context()->variables->are(n=>'Real');
Context()->strings->add(none=>{},EmptySet=>{alias=>"none"});

$a = random(2,5,1);

$b = Compute("$a+1");
$c = Compute("2*$a");
$d = Compute("$a*$b");
$f = Compute("(2*$a-1)*n")->reduce;

$lhs = Compute("n/(n+$a)+1/(n-$b)");
$rhs = Compute("($c-$f)/(n^2-n-$d)");
 
$ans = List("1");

########################################################################

Context()->texStrings;
BEGIN_TEXT
Solve the equation
\[
$lhs = $rhs.
\]
$PAR
Solutions (separate by commas): \(n =\) \{ ans_rule(30) \}
END_TEXT
Context()->normalStrings;

########################################################################

ANS( $ans->cmp()->withPostFilter(AnswerHints(List("1,-$a") => ["Check both of your solutions by plugging them into the equation.",replaceMessage =>1])));

ENDDOCUMENT();  -->
