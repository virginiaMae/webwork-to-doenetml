About the problem: 
************************************************************-->
<problem><title />
<setup>
  <selectFromSequence name="b" from="-5" to="5" exclude="0"/>
  <math name="P" simplify="full">(0,$b)</math>
  <math name="sol1" simplify="full">(0,-$b)</math>
  <math name="sol2" simplify="full">(0,$b)</math>
  <math name="sol3" simplify="full">(0,-$b)</math>
</setup>

<!-- testing -->
<!-- <p>sol1 = $sol1</p>
<p>sol2 = $sol2</p>
<p>sol3 = $sol3</p> -->
<!-- /testing -->

<p>For the point <m>P = $P</m>, determine the points that are symmetric with respect to the <m>x</m>-axis, <m>y</m>-axis, and the origin.</p>
<part>
  <p><answer name="ans1">$sol1</answer> is symmetric to <m>P</m> with respect to the <m>x</m>-axis.</p>
</part>
<part>
  <p><answer name="ans2">$sol2</answer> is symmetric to <m>P</m> with respect to the <m>y</m>-axis.</p>
</part>
<part>
  <p><answer name="ans3">$sol3</answer> is symmetric to <m>P</m> with respect to the origin.</p>
</part>
<p><alert> Note: </alert> <em> Write your answer in the form <m>(a,b)</m> where <m>a</m> and <m>b</m> are numbers.</em></p>

<givenAnswer>
  <part><m>$sol1</m></part>
  <part><m>$sol2</m></part>
  <part><m>$sol3</m></part>
</givenAnswer>
</problem>

