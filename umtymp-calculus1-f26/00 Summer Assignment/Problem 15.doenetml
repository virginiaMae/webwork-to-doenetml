About the problem: 
************************************************************-->
<problem><title />
<setup>
  <!-- Not converted: Perl subroutine `bold` -->
  <math name="w">300</math>
  <math name="tw">400</math>
  <selectFromSequence name="a" from="2" to="4"/>
  <!-- random permutation of 1-4: the order the four functions are listed in -->
  <selectFromSequence name="ord" from="1" to="4" numToSelect="4"/>
  <mathList name="fs">-(x-$a)^4  (x-$a)^4  x^4-$a  -x^4+$a</mathList>
  <textList name="keys">C A B D</textList>
  <function name="p1a" domain="[-8,8]">(x-$a)^4</function>
  <function name="p2a" domain="[-8,8]">x^4-$a</function>
  <function name="p3a" domain="[-8,8]">-(x-$a)^4</function>
  <function name="p4a" domain="[-8,8]">-x^4+$a</function>
</setup>

<!-- testing -->
<!-- <p>a = $a</p>
<p>fs[order[1]] = $fs[$ord[1]]</p> -->
<!-- /testing -->

<p>Match the functions with one of the graphs below.</p>
<sideBySide margins="2%">
  <figure suppressFigureNameInCaption>
    <graph xmin="-8" xmax="8" ymin="-8" ymax="8" grid="1 1">
      <shortDescription>Graph A, showing an upward-opening quartic polynomial with vertex at ($a,0)</shortDescription>
      $p1a
    </graph>
    <caption>A</caption>
  </figure>
  <figure suppressFigureNameInCaption>
    <graph xmin="-8" xmax="8" ymin="-8" ymax="8" grid="1 1">
      <shortDescription>Graph B, showing an upward-opening quartic polynomial with vertex at (0,-$a)</shortDescription>
      $p2a
    </graph>
    <caption>B</caption>
  </figure>
</sideBySide>
<sideBySide margins="2%">
  <figure suppressFigureNameInCaption>
    <graph xmin="-8" xmax="8" ymin="-8" ymax="8" grid="1 1">
      <shortDescription>Graph C, showing a downward-opening quartic polynomial with vertex at ($a,0)</shortDescription>
      $p3a
    </graph>
    <caption>C</caption>
  </figure>
  <figure suppressFigureNameInCaption>
    <graph xmin="-8" xmax="8" ymin="-8" ymax="8" grid="1 1">
      <shortDescription>Graph D, showing a downward-opening quartic polynomial with vertex at (0,a)</shortDescription>
      $p4a
    </graph>
    <caption>D</caption>
  </figure>
</sideBySide>

<ol>
  <li>
    <choiceInput inline name="ci1">
    <label><m>f(x) = $fs[$ord[1]]</m></label>
    <choice>A</choice>
    <choice>B</choice>
    <choice>C</choice>
    <choice>D</choice>
    </choiceInput>
    <answer inline name="ans1" forceSmallCheckWorkButton>
    <award><when>$ci1 = $keys[$ord[1]]</when></award>
  </answer></li>
  <li>
    <choiceInput inline name="ci2">
    <label><m>f(x) = $fs[$ord[2]]</m></label>
    <choice>A</choice>
    <choice>B</choice>
    <choice>C</choice>
    <choice>D</choice>
    </choiceInput>
    <answer inline name="ans2" forceSmallCheckWorkButton>
    <award><when>$ci2 = $keys[$ord[2]]</when></award>
  </answer></li>
  <li>
    <choiceInput inline name="ci3">
    <label><m>f(x) = $fs[$ord[3]]</m></label>
    <choice>A</choice>
    <choice>B</choice>
    <choice>C</choice>
    <choice>D</choice>
    </choiceInput>
    <answer inline name="ans3" forceSmallCheckWorkButton>
    <award><when>$ci3 = $keys[$ord[3]]</when></award>
  </answer></li>
  <li>
    <choiceInput inline name="ci4">
    <label><m>f(x) = $fs[$ord[4]]</m></label>
    <choice>A</choice>
    <choice>B</choice>
    <choice>C</choice>
    <choice>D</choice>
    </choiceInput>
    <answer inline name="ans4" forceSmallCheckWorkButton>
    <award><when>$ci4 = $keys[$ord[4]]</when></award>
  </answer></li>
</ol>
<p><alert> Note: </alert> <em> Use the (+) symbol in the lower-right corner
of the graph to zoom in.</em></p>

<givenAnswer>
<ol>
<li><m>f(x) = $fs[$ord[1]]</m>: $keys[$ord[1]]</li>
<li><m>f(x) = $fs[$ord[2]]</m>: $keys[$ord[2]]</li>
<li><m>f(x) = $fs[$ord[3]]</m>: $keys[$ord[3]]</li>
<li><m>f(x) = $fs[$ord[4]]</m>: $keys[$ord[4]]</li>
</ol>
</givenAnswer>
</problem>

