<problem boxed>
  <setup>
    <selectFromSequence name="a" from="2" to="7" />
    <math name="lhs" simplify="numbersPreserveOrder">$a * t^2 + $a * t - 1</math>
    
    <math name="sol1" simplify="numbersPreserveOrder">(-$a - sqrt($a(4 + $a))) / (2 * $a)</math>
    <math name="sol2" simplify="numbersPreserveOrder">(-$a + sqrt($a(4 + $a))) / (2 * $a)</math>
    <number name="sol1N" displayDecimals="5">$sol1</number>
    <number name="sol2N" displayDecimals="5">$sol2</number>
  </setup>

  <p>Solve the quadratic equation using the method that seems most appropriate to you.</p>
  <p><m>\displaystyle $lhs = 0</m></p>

  <p>
    <answer name="ans1" unorderedCompare>
      <label>Solutions (separate by commas): <m>t =</m></label>
      <award><math>$sol1, $sol2</math></award>
      <award allowedErrorInNumbers="0.01" allowedErrorIsAbsolute><math>$sol1N, $sol2N</math></award>
    </answer>
  </p>

  <givenAnswer>
    <p>Two ways to express the solutions are accepted:</p>
    <ol>
      <li><p><m>t = $sol1, $sol2</m></p></li>
      <li><p><m>t = $sol1N, $sol2N</m></p></li>
    </ol>
  </givenAnswer>
</problem>



<!-- 
##DESCRIPTION
##  Algebra: Quadratic equations 
##ENDDESCRIPTION


## DBsubject(Algebra)
## DBchapter(Quadratic equations and functions)
## DBsection(Solving equations)
## Date(11/24/2009)
## Institution(University of Minnesota)
## Author(Jonathan Rogness)
## Level(2)
## MO(1)
## TitleText1('Algebra for College Students')
## AuthorText1('Kaufmann, Schwitters')
## EditionText1('8')
## Section1('6.5')
## Problem1('20')
## KEYWORDS('algebra', 'quadratic equations', 'quadratic')

########################################################################

DOCUMENT();      

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGcourse.pl"
);

########################################################################

TEXT(beginproblem());

$showPartialCorrectAnswers = 1;

########################################################################

Context("Complex");
Context()->variables->are(t=>'Complex');

$a = random(2,7,1);

$lhs = Compute("$a*t^2 + $a*t -1 ")->reduce;

$an1 = Compute("(-$a - sqrt($a)*sqrt(4+$a))/(2*$a)");
$an2 = Compute("(-$a + sqrt($a)*sqrt(4+$a))/(2*$a)");

$ans = List("$an1, $an2");

########################################################################

Context()->texStrings;
BEGIN_TEXT
Solve the quadratic equation using the method that seems most appropriate to you.
\[
$lhs = 0
\]
$PAR
Solutions (separate by commas): \(t =\) \{ ans_rule(30) \}
END_TEXT
Context()->normalStrings;

########################################################################

ANS( $ans->cmp() );

ENDDOCUMENT(); -->
