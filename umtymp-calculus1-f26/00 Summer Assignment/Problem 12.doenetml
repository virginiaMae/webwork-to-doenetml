<problem boxed="true">
<setup>
  <selectFromSequence name="a" from="1" to="2" />
  <selectFromSequence name="b" from="1" to="2" />
</setup>

<p>Determine whether the following graphs represent a function of <m>x</m>.</p>

<!-- ==================== GRAPH 1 ==================== -->
<part>
<conditionalContent>
  <case condition="$a = 1">
    <graph xmin="-5" xmax="5" ymin="-5" ymax="5" fixAxes="true" grid="true">
      <shortDescription>An absolute value shape with a sharp vertex pointing down at (-1,0), opening upwards.</shortDescription>
      <function domain="[-5,-1]">-x - 1</function>
      <function domain="[-1,5]">x + 1</function>
    </graph>
    <p>Does the graph represent a function of <m>x</m>?
      <answer inline="true">
        <choice credit="1">Yes</choice>
        <choice>No</choice>
      </answer>
    </p>
  </case>
  
  <case condition="$a = 2">
    <graph xmin="-5" xmax="5" ymin="-5" ymax="5" fixAxes="true" grid="true">
      <shortDescription>A diamond shape centered at the origin with vertices at (0,4), (4,0), (0,-4), and (-4,0).</shortDescription>
      <function domain="[-4,0]">-x - 4</function>
      <function domain="[-4,0]">x + 4</function>
      <function domain="[0,4]">x - 4</function>
      <function domain="[0,4]">-x + 4</function>
    </graph>
    <p>Does the graph represent a function of <m>x</m>?
      <answer inline="true">
        <choice>Yes</choice>
        <choice credit="1">No</choice>
      </answer>
    </p>
  </case>
</conditionalContent>
</part>

<hr/>
  
<!-- ==================== GRAPH 2 ==================== -->
<part>

<graph xmin="-5" xmax="5" ymin="-5" ymax="5" fixAxes="true" grid="true">
  <shortDescription>A rational function with two separate branches located in quadrants 1 and 3, asymptotic to the x and y axes.</shortDescription>
  <!-- Divided to safely avoid computational division-by-zero at x = 0 -->
  <function domain="[-5,-0.01]">1/x</function>
  <function domain="[0.01,5]">1/x</function>
</graph>
<p>Does the graph represent a function of <m>x</m>?
  <answer inline="true">
    <choice credit="1">Yes</choice>
    <choice>No</choice>
  </answer>
</p>
</part>

<hr/>

<!-- ==================== GRAPH 3 ==================== -->
<part>

<graph xmin="-5" xmax="5" ymin="-5" ymax="5" fixAxes="true" grid="true">
  <shortDescription>A hyperbola opening symmetrically up and down with vertical vertices at (0,1) and (0,-1).</shortDescription>
  <function>sqrt(1 + x^2)</function>
  <function>-sqrt(1 + x^2)</function>
</graph>
<p>Does the graph represent a function of <m>x</m>?
  <answer inline="true">
    <choice>Yes</choice>
    <choice credit="1">No</choice>
  </answer>
</p>
</part>
  
<hr />

<!-- ==================== GRAPH 4 ==================== -->
<part>

<conditionalContent>
  <case condition="$b = 1">
    <graph xmin="-5" xmax="5" ymin="-5" ymax="5" fixAxes="true" grid="true">
      <shortDescription>A sideways parabola opening to the right, with its vertex positioned at (-2,-2).</shortDescription>
      <function domain="[-2,5]">sqrt(x + 2) - 2</function>
      <function domain="[-2,5]">-sqrt(x + 2) - 2</function>
    </graph>
  </case>
  
  <case condition="$b = 2">
    <graph xmin="-5" xmax="5" ymin="-5" ymax="5" fixAxes="true" grid="true">
      <shortDescription>An ellipse centered at the origin stretching horizontally from -5 to 5 and vertically from -1 to 1.</shortDescription>
      <function domain="[-5,5]">sqrt(1 - (x^2 / 25))</function>
      <function domain="[-5,5]">-sqrt(1 - (x^2 / 25))</function>
    </graph>
  </case>
</conditionalContent>
<p>Does the graph represent a function of <m>x</m>?
  <answer inline="true">
    <choice>Yes</choice>
    <choice credit="1">No</choice>
  </answer>
</p>
</part>


<givenAnswer>
    <ol>
      <li><p><conditionalContent>
        <case condition="$a = 1">Yes</case>
        <case condition="$a = 2">No</case>
      </conditionalContent></p>
      </li>
      <li><p>Yes</p></li>
      <li><p>No</p></li>
      <li><p>No</p></li>
    </ol>
</givenAnswer>
</problem>


<!-- #DESCRIPTION
##  Algebra: Functions
##ENDDESCRIPTION


## DBsubject(Algebra)
## DBchapter(Functions)
## DBsection(Definition, concept)
## Date(01/13/2011)
## Institution(University of Minnesota)
## Author(Justin Sukiennik)
## MLT(graphicConcept)
## Level(2)
## MO(1)
## TitleText1('Algebra for College Students')
## AuthorText1('Kaufmann, Schwitters')
## EditionText1('8')
## Section1('8.1')
## Problem1('')
## KEYWORDS('algebra', 'graph', 'functions')

#####################################################################

DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  "PGunion.pl",
  "MathObjects.pl",
  "PGchoicemacros.pl",
  "PGgraphmacros.pl",
  "choiceUtils.pl",
  "parserPopUp.pl",
  "PGcourse.pl"
);
########################################################################

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

TEXT(beginproblem);

#####################################################################

$w = 250;  # graph size
$tw = 400; # graph size in TeX

##################################################

$a = random(1,2,1);

if ($a==1){
$graph1 = init_graph(-5,-5,5,5,'axes'=>[0,0],'size'=>[400,400]);
$p1a = FEQ("-x-1  for x in <-5,-1> using color:blue weight:2");
$p1b = FEQ("x+1 for x in <-1,5> using color:blue weight:2");
plot_functions($graph1,$p1a,$p1b);

$popup1 = PopUp(['?','Yes', 'No'],'Yes');
}

if ($a==2){
$graph1 = init_graph(-5,-5,5,5,'axes'=>[0,0],'size'=>[400,400]);
$p1a = FEQ("-x-4  for x in <-4,0> using color:blue weight:2");
$p1b = FEQ("x+4 for x in <-4,0> using color:blue weight:2");
$p1c = FEQ("x-4  for x in <0,4> using color:blue weight:2");
$p1d = FEQ("-x+4  for x in <0,4> using color:blue weight:2");
plot_functions($graph1,$p1a,$p1b,$p1c,$p1d);

$popup1 = PopUp(['?','Yes', 'No'],'No');
}

##################################################

$graph2 = init_graph(-5,-5,5,5,'axes'=>[0,0],'size'=>[400,400]);
$p2a = FEQ("1/x for x in <-5,0> using color:blue weight:2");
$p2b = FEQ("1/x for x in <0,5> using color:blue weight:2");
plot_functions($graph2,$p2a,$p2b);

$popup2 = PopUp(['?','Yes', 'No'],'Yes');

##################################################

$graph3 = init_graph(-5,-5,5,5,'axes'=>[0,0],'size'=>[400,400]);
$p3a = FEQ("sqrt(1+x^2) for x in <-5,5> using color:blue weight:2");
$p3b = FEQ("-sqrt(1+x^2) for x in <-5,5> using color:blue weight:2");
plot_functions($graph3,$p3a,$p3b);

$popup3 = PopUp(['?','Yes', 'No'],'No');

##################################################

$b = random(1,2,1);

if ($b==1){
$graph4 = init_graph(-5,-5,5,5,'axes'=>[0,0],'size'=>[400,400]);
$p4a = FEQ("sqrt(x+2)-2  for x in <0,5> using color:blue weight:2");
$p4b = FEQ("-sqrt(x+2)-2  for x in <0,5> using color:blue weight:2");
$p4c = FEQ("sqrt(x+2)-2  for x in <-2,0> using color:blue weight:2");
$p4d = FEQ("-sqrt(x+2)-2  for x in <-2,0> using color:blue weight:2");
plot_functions($graph4,$p4a,$p4b,$p4c,$p4d);

$popup4 = PopUp(['?','Yes', 'No'],'No');
}

if ($b==2){
$graph4 = init_graph(-5,-5,5,5,'axes'=>[0,0],'size'=>[400,400]);
$p4a = FEQ("sqrt(1-(x^2/25))  for x in <-5,0> using color:blue weight:2");
$p4b = FEQ("sqrt(1-(x^2/25))  for x in <0,5> using color:blue weight:2");
$p4c = FEQ("-sqrt(1-(x^2/25))  for x in <-5,0> using color:blue weight:2");
$p4d = FEQ("-sqrt(1-(x^2/25))  for x in <0,5> using color:blue weight:2");
plot_functions($graph4,$p4a,$p4b,$p4c,$p4d);

$popup4 = PopUp(['?','Yes', 'No'],'No');
}

##################################################

sub bold {return $BBOLD.join("",@_).$EBOLD}

@ops = (separation=>30, indent=>0);
#####################################################################
$imageTable =
  BeginTable().
    Row([image(insertGraph($graph1),width=>$w,height=>$w,tex_size=>$tw),image(insertGraph($graph2),width=>$w,height=>$w,tex_size=>$tw)],@ops).
    TableSpace(5).
    AlignedRow([bold('A'),bold('B')],@ops).
    TableSpace(40).
    Row([image(insertGraph($graph3),width=>$w,height=>$w,tex_size=>$tw),image(insertGraph($graph4),width=>$w,height=>$w,tex_size=>$tw)],@ops).
    TableSpace(5).
    AlignedRow([bold('C'),bold('D')],@ops).
  EndTable();

########################################################################

$sl = new_select_list();
$sl->{rf_print_q} = ~~&alt_print_q;
$sl->{separation} = 10;

$sl->qa(
  "\(f(x) = x-$a\)",    "B",
  "\(f(x) = -$a\)",      "C",
  "\(f(x) = -x + $a\)",    "A",
  "\(f(x) = $a x - 1\)",    "D"
);

$sl->choose(4);


########################################################################

BEGIN_TEXT
Determine whether the following graphs represent a function of \(x.\) $HR
\{$popup1->menu\} $BBOLD 1. $EBOLD  Does the graph represent a function of \(x\)? $PAR
\{ image(insertGraph($graph1),width=>$w,height=>$w,tex_size=>$tw) \}
$PAR
\{$popup2->menu\} $BBOLD 2. $EBOLD  Does the graph represent a function of \(x\)? $PAR
\{ image(insertGraph($graph2),width=>$w,height=>$w,tex_size=>$tw) \}
$PAR
\{$popup3->menu\} $BBOLD 3. $EBOLD  Does the graph represent a function of \(x\)? $PAR
\{ image(insertGraph($graph3),width=>$w,height=>$w,tex_size=>$tw) \}
$PAR
\{$popup4->menu\} $BBOLD 4. $EBOLD  Does the graph represent a function of \(x\)? $PAR
\{ image(insertGraph($graph4),width=>$w,height=>$w,tex_size=>$tw) \}
$HR
$BBOLD Note: $EBOLD $BITALIC You can click on the graphs to enlarge the images.$EITALIC
$HR
$BBOLD Note:$EBOLD  $BITALIC You only have three attempts at this problem.$EITALIC
$HR
END_TEXT

#####################################################################

ANS($popup1->cmp);
ANS($popup2->cmp);
ANS($popup3->cmp);
ANS($popup4->cmp);

########################################################################

ENDDOCUMENT();        # This should be the last executable line in the problem. -->
