##############################################################

Context("Numeric");

$a = random(-6,-2,1);
$b = random(3,8,1);
$c = random(9,10,1);
$d = random(1,4,1);

$f = Formula("$a*x+$b");
$g = Formula("$c*x-$d");

$ans1 = $f->eval(x=>-4);
$ans2 = $f->eval(x=>0);
$ans3 = $g->eval(x=>2);
$ans4 = $g->eval(x=>3);

###############################################################

Context()->texStrings;
BEGIN_TEXT
If 
\( \displaystyle f(x) = \begin{cases} 
$a x + $b & \text{for } x \le 0 \\
$c x - $d & \text{for } x > 0 
\end{cases}
\), find the following values. $PAR
$BBOLD 1. $EBOLD \( f(-4) = \) \{ ans_rule(20) \} $PAR
$BBOLD 2. $EBOLD \( f(0) = \) \{ ans_rule(20) \} $PAR
$BBOLD 3. $EBOLD \( f(2) = \) \{ ans_rule(20) \} $PAR
$BBOLD 4. $EBOLD \( f(3) = \) \{ ans_rule(20) \} $PAR
$HR
END_TEXT
Context()->normalStrings;

#####################################################################

ANS($ans1->cmp);
ANS($ans2->cmp);
ANS($ans3->cmp);
ANS($ans4->cmp);

