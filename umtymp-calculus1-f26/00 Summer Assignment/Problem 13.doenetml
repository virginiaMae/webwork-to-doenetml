<problem><title />
<setup>
  <selectFromSequence name="a" from="-6" to="-2"/>
  <selectFromSequence name="b" from="3" to="8"/>
  <selectFromSequence name="c" from="9" to="10"/>
  <selectFromSequence name="d" from="1" to="4"/>
  <function name="f" simplify="numbersPreserveOrder">$a x + $b</function>
  <function name="g" simplify="numbersPreserveOrder">$c x - $d</function>
  <math name="sol1">$$f(-4)</math>
  <math name="sol2">$$f(0)</math>
  <math name="sol3">$$g(2)</math>
  <math name="sol4">$$g(3)</math>
</setup>

<!-- testing -->
<!-- <p>sol1 = $sol1</p>
<p>sol2 = $sol2</p>
<p>sol3 = $sol3</p>
<p>sol4 = $sol4</p> -->
<!-- /testing -->

<p>If <m> \displaystyle f(x) = \begin{cases} $a x + $b & \text{for } x \le 0 \\ $c x - $d & \text{for } x > 0 \end{cases} </m>, find the following values.</p>
<part><p><answer name="ans1"><label><m>f(-4) = </m></label>$sol1</answer></p>
</part>
<part><p><answer name="ans2"><label><m>f(0) = </m></label>$sol2</answer></p>
</part>
<part><p><answer name="ans3"><label><m>f(2) = </m></label>$sol3</answer></p>
</part>
<part><p><answer name="ans4"><label><m>f(3) = </m></label>$sol4</answer></p>
</part>

<givenAnswer>
<part><m>f(-4) = $sol1</m></part>
<part><m>f(0) = $sol2</m></part>
<part><m>f(2) = $sol3</m></part>
<part><m>f(3) = $sol4</m></part>
</givenAnswer>
</problem>

