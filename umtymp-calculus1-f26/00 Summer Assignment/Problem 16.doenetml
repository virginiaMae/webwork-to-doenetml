<problem><title />
<setup>
  <math name="w">300</math>
  <math name="tw">400</math>
  <select name="a" type="number">2 6</select>
  <text name="descripA">
    <conditionalContent>
      <case condition="$a=2">Graph A is a cubic polynomial with roots at -2, 0, and 1.
      As x becomes more negative, the function increases, and as x becomes more positive, the function decreases.</case>
      <case condition="$a=6">Graph A is a cubic polynomial with roots at -3, 0, and 2.
      As x becomes more negative, the function increases, and as x becomes more positive, the function decreases.</case>
    </conditionalContent>
  </text>
  <text name="descripB">
    <conditionalContent>
      <case condition="$a=2">Graph B is a cubic polynomial with roots at -1, 0, and 2.
      As x becomes more negative, the function decreases, and as x becomes more positive, the function increases.</case>
      <case condition="$a=6">Graph B is a cubic polynomial with roots at -2, 0, and 3.
      As x becomes more negative, the function decreases, and as x becomes more positive, the function increases.</case>
    </conditionalContent>
  </text>
  <text name="descripC">
    <conditionalContent>
      <case condition="$a=2">Graph C is a cubic polynomial with roots at -1, 0, and 2.
      As x becomes more negative, the function increases, and as x becomes more positive, the function decreases.</case>
      <case condition="$a=6">Graph C is a cubic polynomial with roots at -2, 0, and 3.
      As x becomes more negative, the function increases, and as x becomes more positive, the function decreases.</case>
    </conditionalContent>
  </text>
  <text name="descripD">
    <conditionalContent>
      <case condition="$a=2">Graph D is a cubic polynomial with roots at -2, 0, and 1.
      As x becomes more negative, the function decreases, and as x becomes more positive, the function increases.</case>
      <case condition="$a=6">Graph D is a cubic polynomial with roots at -3, 0, and 2.
      As x becomes more negative, the function decreases, and as x becomes more positive, the function increases.</case>
    </conditionalContent>
  </text>
  <math name="f1" simplify="numbersPreserveOrder">x^3+x^2-$a*x</math>
  <math name="f2" simplify="numbersPreserveOrder">x^3-x^2-$a*x</math>
  <math name="f3" simplify="numbersPreserveOrder">-x^3-x^2+$a*x</math>
  <math name="f4" simplify="numbersPreserveOrder">-x^3+x^2+$a*x</math>
  <function name="p1" domain="[0,8]" stylenumber="1">$f3</function>
  <function name="p1a" domain="[-8,0]" stylenumber="1">$f3</function>
  <function name="p2" domain="[0,8]" stylenumber="1">$f2</function>
  <function name="p2a" domain="[-8,0]" stylenumber="1">$f2</function>
  <function name="p3" domain="[0,8]" stylenumber="1">$f4</function>
  <function name="p3a" domain="[-8,0]" stylenumber="1">$f4</function>
  <function name="p4" domain="[0,8]" stylenumber="1">$f1</function>
  <function name="p4a" domain="[-8,0]" stylenumber="1">$f1</function>
  <!-- random order of the questions: item i of the list shows question ord[i] -->
  <selectFromSequence name="ord" from="1" to="4" numToSelect="4"/>
  <group name="questions">
    <label><m>f(x) = $f1</m></label>
    <label><m>f(x) = $f2</m></label>
    <label><m>f(x) = $f3</m></label>
    <label><m>f(x) = $f4</m></label>
  </group>
  <textList name="keys">D B A C</textList>
</setup>

<p>Match the polynomial functions with one of the graphs below by first factoring the given polynomials.</p>
<sideBySide margins="2%">
  <figure suppressFigureNameInCaption>
    <graph xmin="-8" xmax="8" ymin="-8" ymax="8" grid="1 1">
      <shortDescription>$descripA</shortDescription>
      $p1
      $p1a
    </graph>
    <caption>A</caption>
  </figure>
  <figure suppressFigureNameInCaption>
    <graph xmin="-8" xmax="8" ymin="-8" ymax="8" grid="1 1">
      <shortDescription>$descripB</shortDescription>
      $p2
      $p2a
    </graph>
    <caption>B</caption>
  </figure>
</sideBySide>
<sideBySide margins="2%">
  <figure suppressFigureNameInCaption>
    <graph xmin="-8" xmax="8" ymin="-8" ymax="8" grid="1 1">
      <shortDescription>$descripC</shortDescription>
      $p3
      $p3a
    </graph>
    <caption>C</caption>
  </figure>
  <figure suppressFigureNameInCaption>
    <graph xmin="-8" xmax="8" ymin="-8" ymax="8" grid="1 1">
      <shortDescription>$descripD</shortDescription>
      $p4
      $p4a
    </graph>
    <caption>D</caption>
  </figure>
</sideBySide>
<ol>
  <li>
    <choiceInput inline name="ci1">$questions[$ord[1]]
    <choice>A</choice>
    <choice>B</choice>
    <choice>C</choice>
    <choice>D</choice>
    </choiceInput>
  </li>
  <li>
    <choiceInput inline name="ci2">$questions[$ord[2]]
    <choice>A</choice>
    <choice>B</choice>
    <choice>C</choice>
    <choice>D</choice>
    </choiceInput>
  </li>
  <li>
    <choiceInput inline name="ci3">$questions[$ord[3]]
    <choice>A</choice>
    <choice>B</choice>
    <choice>C</choice>
    <choice>D</choice>
    </choiceInput>
  </li>
  <li>
    <choiceInput inline name="ci4">$questions[$ord[4]]
    <choice>A</choice>
    <choice>B</choice>
    <choice>C</choice>
    <choice>D</choice>
    </choiceInput>
  </li>
</ol>
<answer name="ans1"><shortDescription>Check all answers</shortDescription><award><when>$ci1 = $keys[$ord[1]] and $ci2 = $keys[$ord[2]] and $ci3 = $keys[$ord[3]] and $ci4 = $keys[$ord[4]]</when></award></answer>
<p><alert> Note: </alert> <em> Use the (+) symbol in the lower-right corner of the graph to zoom in.</em></p>

<givenAnswer>
  <ol>
    <li>$questions[$ord[1]]: $keys[$ord[1]]</li>
    <li>$questions[$ord[2]]: $keys[$ord[2]]</li>
    <li>$questions[$ord[3]]: $keys[$ord[3]]</li>
    <li>$questions[$ord[4]]: $keys[$ord[4]]</li>
  </ol>
</givenAnswer>
</problem>

<!-- Generated from this WeBWorK problem: -->
<!--
#DESCRIPTION
##  Algebra: Graphing polynomial functions
##ENDDESCRIPTION


## DBsubject(Algebra)
## DBchapter(Polynomial equations and functions)
## DBsection(Zeros and multiplicities)
## Date(01/07/2010)
## Institution(University of Minnesota)
## Author(Justin Sukiennik)
## MLT(MLT02)
## Level(2)
## TitleText1('Algebra for College Students')
## AuthorText1('Kaufmann, Schwitters')
## EditionText1('8')
## Section1('9.4')
## Problem1('')
## KEYWORDS('algebra', 'graph', 'functions', 'polynomials', 'cubic')

DOCUMENT();        # This should be the first executable line in the problem.

#####################################################################
loadMacros(
  "PGstandard.pl",
  "PGunion.pl",
  "MathObjects.pl",
  "PGchoicemacros.pl",
  "PGgraphmacros.pl",
  "choiceUtils.pl",
  "PGcourse.pl"
);

#####################################################################
TEXT(beginproblem());

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

#####################################################################
$w = 300;  # graph size
$tw = 400; # graph size in TeX

$a = list_random(2,6);

Context("Numeric");

$f1 = Formula("x^3+x^2-$a*x");
$f2 = Formula("x^3-x^2-$a*x");
$f3 = Formula("-x^3-x^2+$a*x");
$f4 = Formula("-x^3+x^2+$a*x");

$graph1 = init_graph(-8,-8,8,8,'axes'=>[0,0],'ticks'=>[16,16],'grid'=>[16,16],'size'=>[400,400]);

$graph2 = init_graph(-8,-8,8,8,'axes'=>[0,0],'ticks'=>[16,16],'grid'=>[16,16],'size'=>[400,400]);

$graph3 = init_graph(-8,-8,8,8,'axes'=>[0,0],'ticks'=>[16,16],'grid'=>[16,16],'size'=>[400,400]);

$graph4 = init_graph(-8,-8,8,8,'axes'=>[0,0],'ticks'=>[16,16],'grid'=>[16,16],'size'=>[400,400]);

$p1 = FEQ("$f3 for x in <0,8> using color:blue weight:2");
$p1a = FEQ("$f3 for x in <-8,0> using color:blue weight:2");
$p2 = FEQ("$f2 for x in <0,8> using color:blue weight:2");
$p2a = FEQ("$f2 for x in <-8,0> using color:blue weight:2");
$p3 = FEQ("$f4 for x in <0,8> using color:blue weight:2");
$p3a = FEQ("$f4 for x in <-8,0> using color:blue weight:2");
$p4 = FEQ("$f1 for x in <0,8> using color:blue weight:2");
$p4a = FEQ("$f1 for x in <-8,0> using color:blue weight:2");

plot_functions($graph1,$p1,$p1a);
plot_functions($graph2,$p2,$p2a);
plot_functions($graph3,$p3,$p3a);
plot_functions($graph4,$p4,$p4a);

##################################################

sub bold {return $BBOLD.join("",@_).$EBOLD}

@ops = (separation=>30, indent=>0);
#####################################################################
$imageTable =
  BeginTable().
    Row([image(insertGraph($graph1),width=>$w,height=>$w,tex_size=>$tw),image(insertGraph($graph2),width=>$w,height=>$w,tex_size=>$tw)],@ops).
    TableSpace(5).
    AlignedRow([bold('A'),bold('B')],@ops).
    TableSpace(40).
    Row([image(insertGraph($graph3),width=>$w,height=>$w,tex_size=>$tw),image(insertGraph($graph4),width=>$w,height=>$w,tex_size=>$tw)],@ops).
    TableSpace(5).
    AlignedRow([bold('C'),bold('D')],@ops).
  EndTable();

###############################################################

Context()->texStrings;

$sl = new_select_list();
$sl->{rf_print_q} = ~~&alt_print_q;
$sl->{separation} = 10;

$sl->qa(
  "\(f(x) = $f1\)",    "D",
  "\(f(x) = $f2\)",      "B",
  "\(f(x) = $f3\)",    "A",
  "\(f(x) = $f4\)",    "C"
);

$sl->choose(4);

########################################################################

BEGIN_TEXT
Match the polynomial functions with one of the graphs below by first factoring the given polynomials.
$PAR $imageTable $PAR
$HR
\{$sl->print_q\}
$HR
$BBOLD Note: $EBOLD $BITALIC You can click on the graphs to enlarge the images.$EITALIC
$HR
END_TEXT
Context()->normalStrings;

#####################################################################

ANS(str_cmp($sl->ra_correct_ans));

########################################################################

ENDDOCUMENT();        # This should be the last executable line in the problem.

-->
