<problem boxed>

<setup>
  <select name="s1" numToSelect="4">
    <option>
      <m>\sqrt[3]{16}=2\;</m>
      <text>F</text>
    </option>
    <option>
      <m>\frac{1}{\sqrt{2}}=\frac{\sqrt{2}}{2}\;</m>
      <text>T</text>
    </option>
    <option>
      <m>\frac{2}{\sqrt[3]{3}}=\frac{2\sqrt{9}}{3}\;</m>
      <text>F</text>
    </option>
    <option>
      <m>\frac{\sqrt{11}}{24}=\frac{24}{\sqrt{11}}\;</m>
      <text>F</text>
    </option>
    <option>
      <m>\sqrt[5]{-32}=-2\;</m>
      <text>T</text>
    </option>
    <option>
      <m>\frac{\sqrt{2}}{2}=\sqrt{\frac{10}{20}}\;</m>
      <text>T</text>
    </option>
  </select>
  <m name="m1" extend="$s1[1][1]"/>
  <m name="m2" extend="$s1[2][1]"/>
  <m name="m3" extend="$s1[3][1]"/>
  <m name="m4" extend="$s1[4][1]"/>
  <text name="t1" extend="$s1[1][2]"/>
  <text name="t2" extend="$s1[2][2]"/>
  <text name="t3" extend="$s1[3][2]"/>
  <text name="t4" extend="$s1[4][2]"/>
</setup>

<!-- testing -->
<!-- <p>s1 = $s1</p> -->
<!-- testing -->
  
<p>Determine whether the following equalities are true or false. Enter <alert>T</alert> for true and <alert>F</alert> for false.</p>

<part>
  <p>
    <answer name="ans1" type="text" caseInsensitiveMatch>
      <textInput width="30">
        <label>$m1</label>
      </textInput>
      $t1
    </answer>
  </p>
</part>
<part>
  <p>
    <answer name="ans2" type="text" caseInsensitiveMatch>
      <textInput width="30">
        <label>$m2</label>
      </textInput>
      $t2
    </answer>
  </p>
</part>
<part>
  <p>
    <answer name="ans3" type="text" caseInsensitiveMatch>
      <textInput width="30">
        <label>$m3</label>
      </textInput>
      $t3
    </answer>
  </p>
</part>
<part>
  <p>
    <answer name="ans4" type="text" caseInsensitiveMatch>
      <textInput width="30">
        <label>$m4</label>
      </textInput>
      $t4
    </answer>
  </p>
</part>


<givenAnswer>
  <ol>
    <li><p>$m1 , $t1</p></li>
    <li><p>$m2 , $t2</p></li>
    <li><p>$m3 , $t3</p></li>
    <li><p>$m4 , $t4</p></li>
  </ol>
</givenAnswer>
</problem>




<!-- ##DESCRIPTION
##  Algebra: exponents and radicals 
##ENDDESCRIPTION


## DBsubject(Arithmetic)
## DBchapter(Irrational numbers)
## DBsection(Simplify radical numbers)
## Date(10/27/2009)
## Institution(University of Minnesota)
## Author(Justin Sukiennik)
## Level(2)
## TitleText1('Algebra for College Students')
## AuthorText1('Kaufmann, Schwitters')
## EditionText1('8')
## Section1('5.2')
## Problem1('')
## KEYWORDS('algebra', 'radicals')

########################################################################

DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  "PGchoicemacros.pl",
  "PGunion.pl",
  "choiceUtils.pl",
  "PGcourse.pl"
);

########################################################################

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

TEXT(beginproblem);

########################################################################

$sl = new_select_list();
$sl->{rf_print_q} = ~~&alt_print_q;
$sl->{separation} = 10;

$sl->qa(
  "\(\sqrt[3]{16}=2\)",    "F",
  "\(\displaystyle \frac{1}{\sqrt{2}}=\frac{\sqrt{2}}{2}\)",      "T",
  "\(\displaystyle \frac{2}{\sqrt[3]{3}}=\frac{2\sqrt{9}}{3}\)",      "F",
  "\(\displaystyle \frac{\sqrt{11}}{24}=\frac{24}{\sqrt{11}}\)",    "F",
  "\(\sqrt[5]{-32}=-2\)",    "T",
  "\(\displaystyle \frac{\sqrt{2}}{2}=\sqrt{\frac{10}{20}\;}\)",    "T"
);

$sl->choose(4);

########################################################################

BEGIN_TEXT
Determine whether the following equalities are true or false.  Enter "T" for true and "F" for false.
$PAR
$BBLOCKQUOTE
\{$sl->print_q\}
$EBLOCKQUOTE
$PAR 
$HR
END_TEXT

########################################################################

ANS(str_cmp($sl->ra_correct_ans));

ENDDOCUMENT();        # This should be the last executable line in the problem. -->
