<problem boxed>
  <setup>
    <selectFromSequence name="a" from="1" to="5" />
    <selectFromSequence name="b" from="2" to="6" step="2" />
    <selectFromSequence name="c" from="7" to="11" step="4" />
  </setup>

  <p>Find a formula for the inverse of the function <m>f(x) = $a + \sqrt{$b+$c x}.</m></p>

  <part>
    <p>Find the formula for the inverse function.
      <br />
      <answer name="ans1">
        <label><m>f^{-1}(x) =</m></label>
        <math name="sol1">((x - $a)^2 / $c) - ($b / $c)</math>
      </answer>
    </p>
  </part>

  <part>
    <p>What is the domain of the inverse function <m>f^{-1}</m> ?
      <br />
      <answer name="ans2">
        <label>Answer (in interval notation):</label>
        <math name="sol2">[$a, infinity)</math>
      </answer>
    </p>
  </part>

  <givenAnswer>
    <ol>
      <li><p><m>f^{-1}(x) = $sol1</m></p></li>
      <li><p><m>$sol2</m></p></li>
    </ol>
  </givenAnswer>
</problem>



<!-- #DESCRIPTION
##  Calculus: Functions
##ENDDESCRIPTION


