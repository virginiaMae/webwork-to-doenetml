<problem boxed>
  <setup>
    <selectFromSequence name="a" from="1" to="3"/>
    <select name="b">16 25 36</select>
    <number name="sqrtB">sqrt($b)</number>
    <!-- <math name="sqrtB" simplify>sqrt($b)</math> -->
    <math name="f">sqrt($a - x)</math>
    <math name="g">sqrt($b - x^2)</math>

    <math name="ans1">$f + $g</math>
    <math name="ans3">$f - $g</math>
    <math name="ans5">sqrt(($a - x)($b - x^2))</math>
    <math name="ans7">$f / $g</math>

    <math name="ans2">[-$sqrtB, $a]</math>
    <math name="ans4">[-$sqrtB, $a]</math>
    <math name="ans6">[-$sqrtB, $a]</math>
    <math name="ans8">(-$sqrtB, $a]</math>
  </setup>

  <p>
    Let <m>f(x) = $f</m> and <m>g(x) = $g.</m> Find <m>f + g,</m> <m>f - g,</m> <m>f \cdot g,</m> and <m>\frac{f}{g}</m>, and their respective domains. Enter domain responses in interval notation.
  </p>

<!-- <div sectionWideCheckWork> -->
  <part>
    <p> 
    <answer name="q1">
      <label><m>f + g = </m></label>
      <award>$ans1</award>
    </answer></p>
  </part>
  
  <part>
    <p> 
    <answer name="q2">
      <label>What is the domain of <m>f + g</m>?</label>
      <award>$ans2</award>
    </answer></p>
  </part>

  <part>
    <p> 
    <answer name="q3">
      <label><m>f - g =</m></label>
      <award>$ans3</award>
    </answer></p>
  </part>
  
  <part>
    <p>
    <answer name="q4">
      <label>What is the domain of <m>f - g</m>?</label>
      <award>$ans4</award>
    </answer></p>
  </part>

  <part>
    <p>
    <answer name="q5">
      <label><m>f \cdot g =</m> </label>
      <award>$ans5</award>
    </answer>
    </p>
  </part>
  
  <part>
    <p>
    <answer name="q6">
      <label>What is the domain of <m>f \cdot g</m>?</label>
      <award>$ans6</award>
    </answer></p>
  </part>

  <part>
    <p>
    <answer name="q7">
      <label><m>\frac{f}{g} =</m> </label>
      <award>$ans7</award>
    </answer></p>
  </part>
  
  <part>
    <p>
    <answer name="q8">
      <label>What is the domain of <m>\frac{f}{g}</m>?</label>
      <award>$ans8</award>
    </answer></p>
  </part>
<!-- </div> -->

<givenAnswer>
  <ol>
    <li><p>$ans1</p></li>
    <li><p>$ans2</p></li>
    <li><p>$ans3</p></li>
    <li><p>$ans4</p></li>
    <li><p>$ans5</p></li>
    <li><p>$ans6</p></li>
    <li><p>$ans7</p></li>
    <li><p>$ans8</p></li>
  </ol>
</givenAnswer>

