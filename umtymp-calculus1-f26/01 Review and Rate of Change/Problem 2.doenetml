<problem boxed>
  <setup>
    <selectFromSequence name="a" from="2" to="12"/>

    <math name="aid1" simplify>$a - 1</math>
    <math name="aid2" simplify>$a + 1</math>

    <math name="ans1">(-infinity, 0) union (0, infinity)</math>
    <math name="ans2">{$aid1, $aid2}</math>
  </setup>

<!-- testing -->
<!-- <p>check 1: <boolean>$ans1 = $userDomain</boolean></p> -->
<!-- testing -->
  
  <p>
    Find the domain and range for the function <m>G(x) = \frac{$a x + |x|}{x}.</m>
  </p>


  <part>
    <p>
      <answer name="q1">
        <mathInput name="userDomain" unionFromU="true">
        <label>Domain (in interval or set notation): </label>
        </mathInput>
        <award>$ans1</award>
      </answer>
    </p>
  </part>

  <part>
    <p>
      <answer name="q2">
        <label>Range (in interval or set notation): </label>
        <award>$ans2</award>
      </answer>
    </p>
  </part>

<givenAnswer>
  <ol>
    <li>$ans1</li>
    <li>$ans2</li>
  </ol>
</givenAnswer>
</problem>





<!-- Source code

#DESCRIPTION
##  Calculus: Functions
##ENDDESCRIPTION


## DBsubject(Algebra)
## DBchapter(Functions)
## DBsection(Domain and range)
## Date(08/26/2010)
## Institution(University of Minnesota)
## Author(Justin Sukiennik)
## MLT(DomainRangeLinearDenominator)
## Level(2)
## MO(1)
## TitleText1('Calculus: Concepts and Contexts')
## AuthorText1('Stewart')
## EditionText1('4 Custom UMTYMP Ed.')
## Section1('1.1')
## Problem1('41')
## KEYWORDS('calculus', 'function', 'domain', 'range')

#####################################################################
DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "answerHints.pl",
  "parserPopUp.pl",
  "PGcourse.pl"
);

#####################################################################
install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

TEXT(beginproblem());
#####################################################################

Context("Interval");
# Let students type "EmptySet" instead of "NONE"
Context()->constants->add(EmptySet => Set());
Context()->flags->set(noneWord=>"EmptySet");

$a = random(2,12,1);

$aid1 = Compute($a-1);
$aid2 = Compute($a+1);

$a1 = Interval("(-infinity, 0)");
$a2 = Interval("(0, infinity)");

$ans1 = Union("$a1 U $a2");
$ans2 = Set("{$aid1, $aid2}");

#####################################################################

Context()->texStrings;
BEGIN_TEXT
Find the domain and range for the function \(\displaystyle G(x) = \frac{$a x + |x|}{x}.\) 
$HR
Domain (in interval or set notation): \{ans_rule(20)\}
$PAR
Range (in interval or set notation): \{ans_rule(20)\}
$PAR
$BBOLD Note:$EBOLD
Click here for information on \{helpLink('interval notation')\}.
$HR
END_TEXT

#####################################################################

ANS(($ans1)->cmp());
ANS(($ans2)->cmp(showTypeWarnings=>0)->withPostFilter(AnswerHints(List("$aid1, $aid2") => ["This is not a proper way to write this set.  Try {$aid1, $aid2} instead."])));

ENDDOCUMENT();        # This should be the last executable line in the problem. -->
