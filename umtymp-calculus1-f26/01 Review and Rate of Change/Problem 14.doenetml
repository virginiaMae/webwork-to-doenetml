<problem boxed>
  <setup>
    <select name="a">
      <option>1</option>
      <option>3</option>
      <option>5</option>
      <option>7</option>
      <option>9</option>
    </select>
    <selectFromSequence name="b" from="2" to="4" step="2" />
  </setup>

  <p>Find a formula for the inverse of the function <m>g(x) = \frac{e^x}{$a+$b e^x}.</m></p>

  <p>
    <answer name="ans1">
      <label><m>g^{-1}(x) =</m></label>
      <math name="sol1" simplify="numbersPreserveOrder">ln($a*x)-ln(1-$b*x)</math>
    </answer>
  </p>

  <givenAnswer>
    <p><m>g^{-1}(x) = $sol1</m></p>
  </givenAnswer>
</problem>



