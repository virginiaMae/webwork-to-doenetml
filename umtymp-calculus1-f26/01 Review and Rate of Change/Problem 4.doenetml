<problem boxed >
  <setup>
    <styleDefinition styleNumber="2" lineStyle="dashed" lineStyleWord="dashed"/>
    <selectFromSequence name="a" from="1" to="4"/> 

<!-- here, since we selected a random number "a" from 1 to 4, we can use a component called a mathList or a textList instead, and then when referencing f, g, ans1, or ans2, simply use the index within that reference, such as $f[$a] -->
    
    <!-- <select name="f" index="$a">
      <math>2 cos(x/2)+4</math>
      <math>2 sin(x/2)-4</math>
      <math>4 arctan(x)</math>
      <math>2 sin(x/2)+4</math>
    </select> -->

    <mathList name="f">
      <math>2 cos(x/2)+4</math>
      <math>2 sin(x/2)-4</math>
      <math>4 arctan(x)</math>
      <math>2 sin(x/2)+4</math>
    </mathList>

    <!-- <select name="g" index="$a">
      <math>(x-2.5)(x+2.5)x</math>
      <math>(1/32)(x-2)(x+2)(x-4)(x+4)</math>
      <math>4-(1/8)*x^2</math>
      <math>4-(1/8)*x^2</math>
    </select> -->

     <mathList name="g">
      <math>(x-2.5)(x+2.5)x</math>
      <math>(1/32)(x-2)(x+2)(x-4)(x+4)</math>
      <math>4-(1/8)*x^2</math>
      <math>4-(1/8)*x^2</math>
    </mathList>

    <!-- <select name="ans1" index="$a">
      <text>Even</text>
      <text>Neither</text>
      <text>Odd</text>
      <text>Neither</text>
    </select> -->

    <textList name="ans1">
      <text>Even</text>
      <text>Neither</text>
      <text>Odd</text>
      <text>Neither</text>
    </textList>

    <!-- <select name="ans2" index="$a">
      <text>Odd</text>
      <text>Even</text>
      <text>Even</text>
      <text>Even</text>
    </select> -->

    <textList name="ans2">
      <text>Odd</text>
      <text>Even</text>
      <text>Even</text>
      <text>Even</text>
    </textList>

    <p name="description">
      <conditionalContent>
        <case condition="$a = 1">Function <m>f</m> is the $f_graph.styleDescriptionWithNoun. It is a periodic curve that has been shifted vertically upward 4 units and crosses the y-axis at <m>y = 6</m> at a local maximum. This function is symmetric about the y-axis. Function <m>g</m> is the $g_graph.styleDescriptionWithNoun. It is a smooth polynomial with a local maximum at <m>$g_graph.maxima</m>. It passes through the origin, and has a local minimum at <m>$g_graph.minima</m>.  This function is symmetric about the origin.</case>
        <case condition="$a = 2">Function <m>f</m> is the $f_graph.styleDescriptionWithNoun. It is a periodic curve that has been shifted vertically downward 4 units and crosses the y-axis at <m>y = -4</m>. This function is not symmetric about the y-axis. Function <m>g</m> is the $g_graph.styleDescriptionWithNoun. It is a smooth polynomial with a local minimum at <m>$g_graph.minima[1]</m>. From this minimum, the function increases as x increases and crosses the y-axis at a local maximum at <m>y = 2</m>, then decreases to another local minimum at <m>$g_graph.minima[2]</m>.  This function is symmetric about the y-axis.</case>
        <case condition="$a = 3">Function <m>f</m> is the $f_graph.styleDescriptionWithNoun. It is negative in the third quadrant, rises sharply near <m>x = -2</m>, passes through the origin, and is positive in the first quadrant. This function is symmetric about the origin. Function <m>g</m> is the $g_graph.styleDescriptionWithNoun. It is a downward-opening parabola with vertex at <m>(0,4)</m>. This function is symmetric about the y-axis.</case>
        <case condition="$a = 4">Function <m>f</m> is the $f_graph.styleDescriptionWithNoun. It is a periodic curve that has been vertically shifted 4 units upward and crosses the y-axis at <m>y = 4</m>. This function is not symmetric about the y-axis. Function <m>g</m> is the $g_graph.styleDescriptionWithNoun. It is a downward-opening parabola with vertex at <m>(0,4)</m>. This function is symmetric about the y-axis.</case>
      </conditionalContent>
    </p>
  </setup>

<!-- testing -->
<!-- <p>a = $a</p>
<p>f = $f[$a]</p>
<p>g = $g[$a]</p>
<p>ans1 = $ans1[$a]</p>
<p>ans2 = $ans2[$a]</p>
<p>g.maxima = $g_graph.maxima</p>
<p>g.minima = $g_graph.minima</p> -->
<!-- testing -->

  <p>
    The graph below has two functions <m>f</m> and <m>g</m>. On the graph, <m>f</m> is the $f_graph.styleDescriptionWithNoun and <m>g</m> is the $g_graph.styleDescriptionWithNoun.
  </p>

  <graph name="g1" xmin="-8" xmax="8" ymin="-8" ymax="8">
    <!-- Note, we need to provide the same level of critical information for both sighted users and screen-reader users, so we need a more detailed description that adapts to the variant selected. To do this, we create a conditionalContent that changes what the description of the graph displays. The shortDescription then points to the longer description for more information -->
    <shortDescription>Graph of two functions. Please see disclosure triangle below the graph for more details.</shortDescription>
    <!-- <function name="f_graph" styleColor="red" styleNumber="1">$f</function>
    <function name="g_graph" styleColor="blue" styleNumber="2">$g</function>

    Note, there is no attribute called "styleColor". However, using styleNumber specifies the color automatically. -->

    <!-- <function name="f_graph" styleNumber="1">$f</function>
    <function name="g_graph" styleNumber="2">$g</function> 
    Note, in order to pick the correct function from the list, we apply the index here-->
    <function name="f_graph" styleNumber="1" labelPosition="lowerLeft" >$f[$a]
      <label><m>f</m></label>
    </function>
    <function name="g_graph" styleNumber="2">$g[$a]
      <label><m>g</m></label>
    </function>
    <description>$description</description>
  </graph>

  <p>
    Determine whether the functions <m>f</m> and <m>g</m> are: <em>odd</em>, <em>even</em>, or <em>neither</em>.
  </p>

<!-- <div sectionWideCheckWork> -->
  <part>
    <p>
      <!-- <answer name="q1"> Note, we need the attribute type="text" for non-math inputs-->
      <answer name="q1" inline maxNumAttempts="1">
          <!-- <label>1. The function <m>f</m> (in red) is (enter Odd, Even, or Neither): </label> 
          Note, there's no need to include a number manually in the label, because the <part> component auto-numbers -->
          <label>The $f_graph.styleDescriptionWithNoun <m>f</m> is: </label>
        <choice credit="$ans1[$a] = Odd">Odd</choice>
        <choice credit="$ans1[$a] = Even">Even</choice>
        <choice credit="$ans1[$a] = Neither">Neither</choice>
      </answer>
    </p>
  </part>

  <part>
    <p>
       <!-- <answer name="q2"> Note, we need the attribute type="text" for non-math inputs-->
      <answer name="q2" inline maxNumAttempts="1">
          <label>The $g_graph.styleDescriptionWithNoun <m>g</m> is (enter Odd, Even, or Neither): </label>
        <choice credit="$ans2[$a] = Odd">Odd</choice>
        <choice credit="$ans2[$a] = Even">Even</choice>
        <choice credit="$ans2[$a] = Neither">Neither</choice>
      </answer>
    </p>
  </part>
<!-- </div> -->

  <givenAnswer>
    <ol>
      <!-- <li>$ans1</li>
      <li>$ans2</li> Note, we also need indexes here-->
      <li>$ans1[$a]</li>
      <li>$ans2[$a]</li>
    </ol>
  </givenAnswer>
</problem>


<!-- Remember please to include a commented-out copy of the source code text below the problem -->

<!-- 
#DESCRIPTION
##  Calculus: Functions
##ENDDESCRIPTION


## DBsubject(Algebra)
## DBchapter(Transformations of functions and graphs)
## DBsection(Symmetry: even, odd, neither)
## Date(08/26/2010)
## Institution(University of Minnesota)
## Author(Justin Sukiennik)
## Level(2)
## MO(1)
## TitleText1('Calculus: Concepts and Contexts')
## AuthorText1('Stewart')
## EditionText1('4 Custom UMTYMP Ed.')
## Section1('1.1')
## Problem1('63')
## KEYWORDS('calculus', 'function', 'even', 'odd')


#####################################################################
DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  "PGunion.pl",
  "MathObjects.pl",
  "parserPopUp.pl",
  "PGchoicemacros.pl",
  "PGgraphmacros.pl",
  "PGcourse.pl"
);
#####################################################################

TEXT(beginproblem());

install_problem_grader(~~&std_problem_grader);

$showPartialCorrectAnswers = 0;

#####################################################################

$a = random(1,4,1);

if ($a==1){
$f = Formula("2 cos(x/2)+4");
$g = Formula("(x-2.5)(x+2.5)x");

$popup1 = PopUp(['?','Odd', 'Even', 'Neither'],'Even');
$popup2 = PopUp(['?','Odd', 'Even', 'Neither'],'Odd');
}

if ($a==2){
$f = Formula("2 sin(x/2)-4");
$g = Formula("(1/32)(x-2)(x+2)(x-4)(x+4)");

$popup1 = PopUp(['?','Odd', 'Even', 'Neither'],'Neither');
$popup2 = PopUp(['?','Odd', 'Even', 'Neither'],'Even');
}

if ($a==3){
$f = Formula("4 arctan(x)");
$g = Formula("4-(1/8)*x^2");

$popup1 = PopUp(['?','Odd', 'Even', 'Neither'],'Odd');
$popup2 = PopUp(['?','Odd', 'Even', 'Neither'],'Even');
}

if ($a==4){
$f = Formula("2 sin(x/2)+4");
$g = Formula("4-(1/8)*x^2");

$popup1 = PopUp(['?','Odd', 'Even', 'Neither'],'Neither');
$popup2 = PopUp(['?','Odd', 'Even', 'Neither'],'Even');
}

###############################################################

$w = 400;  # graph size
$tw = 500; # graph size in TeX

$graph1 = init_graph(-8,-8,8,8,'axes'=>[0,0],'ticks'=>[16,16],'grid'=>[16,16],'size'=>[500,500]);

$p1 = FEQ("$f for x in <-8,0> using color:red weight:2");
$p1a = FEQ("$f for x in <0,8> using color:red weight:2");
$p2 = FEQ("$g for x in <-8,0> using color:blue weight:2");
$p2a = FEQ("$g for x in <0,8> using color:blue weight:2");

plot_functions($graph1,$p1,$p1a,$p2,$p2a);

###############################################################
Context()->texStrings;

BEGIN_TEXT
The graph below has two functions \(f\) (in red) and \(g\) (in blue).
$PAR
$BCENTER
\{image(insertGraph($graph1),width=>$w,height=>$w,tex_size=>$tw)\}
$ECENTER $PAR
Determine whether the functions \(f\) and \(g\) are: $BITALIC odd,$EITALIC $BITALIC even,$EITALIC or $BITALIC neither. $EITALIC $BR
$HR
$BBOLD 1. $EBOLD The function \(f\) (in red) is  \{$popup1->menu\}.
$PAR
$BBOLD 2. $EBOLD  The function \(g\) (in blue) is  \{$popup2->menu\}.
$HR
$BBOLD Note:$EBOLD  $BITALIC You only have two attempts at this problem.$EITALIC
$HR
$BBOLD Note: $EBOLD $BITALIC You can click on the graph to enlarge the image.$EITALIC
$HR
END_TEXT

Context()->normalStrings;

#####################################################################

ANS($popup1->cmp);
ANS($popup2->cmp);

ENDDOCUMENT();        # This should be the last executable line in the problem. -->
