    <case condition="$a=1">-x-1 </case>
    <case condition="$a=2">-x-4 </case>
  </conditionalContent></function>
  <function name="p1b" domain="[-1,5]" stylenumber="2"><conditionalContent>
    <case condition="$a=1">x+1</case>
    <case condition="$a=2">x+4</case>
  </conditionalContent></function>
  <!-- Unknown function PopUp -->
  <conditionalContent>
