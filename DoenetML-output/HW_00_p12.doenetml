    <case condition="$a=2">x-4 </case>
  </conditionalContent></function>
  <function name="p1d" domain="[0,4]" stylenumber="6"><conditionalContent>
    <case condition="$a=2">-x+4 </case>
  </conditionalContent></function>
  <function name="p2a" domain="[-5,0]" stylenumber="7">1/x</function>
  <function name="p2b" domain="[0,5]" stylenumber="8">1/x</function>
  <!-- Unknown function PopUp -->
  
  <function name="p3a" domain="[-5,5]" stylenumber="9">sqrt(1+x^2)</function>
  <function name="p3b" domain="[-5,5]" stylenumber="10">-sqrt(1+x^2)</function>
  <!-- Unknown function PopUp -->
  
  <selectFromSequence name="b" from="1" to="2"/>
  <function name="p4a" domain="[0,5]" stylenumber="11"><conditionalContent>
    <case condition="$b=1">sqrt(x+2)-2 </case>
    <case condition="$b=2">sqrt(1-(x^2/25)) </case>
  </conditionalContent></function>
  <function name="p4b" domain="[0,5]" stylenumber="12"><conditionalContent>
    <case condition="$b=1">-sqrt(x+2)-2 </case>
    <case condition="$b=2">sqrt(1-(x^2/25)) </case>
  </conditionalContent></function>
  <function name="p4c" domain="[-2,0]" stylenumber="13"><conditionalContent>
    <case condition="$b=1">sqrt(x+2)-2 </case>
    <case condition="$b=2">-sqrt(1-(x^2/25)) </case>
  </conditionalContent></function>
  <function name="p4d" domain="[-2,0]" stylenumber="14"><conditionalContent>
    <case condition="$b=1">-sqrt(x+2)-2 </case>
    <case condition="$b=2">-sqrt(1-(x^2/25)) </case>
  </conditionalContent></function>
  <!-- Unknown function PopUp -->
  <conditionalContent>
